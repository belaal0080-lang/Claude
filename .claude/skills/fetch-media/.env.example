# Unsplash API Configuration (optional)
# Get your API key from: https://unsplash.com/oauth/applications
UNSPLASH_API_KEY=your_access_key_here

# Pixabay API Configuration (optional)
# Get your API key from: https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_api_key_here

# Pexels API Configuration (optional)
# Get your API key from: https://www.pexels.com/api/new/
PEXELS_API_KEY=your_pexels_api_key_here

# Optional: Override default download directory
# DOWNLOAD_DIR=/path/to/downloads
