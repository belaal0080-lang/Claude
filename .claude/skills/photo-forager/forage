#!/usr/bin/env python3
"""Standalone launcher so `forage` works from any directory.

Usage:
  python3 ~/Tools/photo-forager/forage search "autumn forest"
  ~/Tools/photo-forager/forage download --pick 1,3   (after chmod +x)
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from photo_forager.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
