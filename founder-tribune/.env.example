# Copy to .env and fill in. Never commit .env.

PORT=3000
# Public address of the site, used in the RSS feed, sitemap and share previews
SITE_URL=https://www.foundertribune.com

# Secret admin address: the panel lives at https://your-site/<ADMIN_PATH>
# Leave empty to have one generated and printed on first start.
ADMIN_PATH=
# Admin password. Leave empty to have one generated and printed on first start.
ADMIN_PASSWORD=

# Claude API key from https://console.anthropic.com (needed only for AI drafts)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Apify token from https://console.apify.com/settings/integrations (needed for trending stories from X)
APIFY_TOKEN=
# News accounts on X to read each day, without the @
X_ACCOUNTS=Reuters,AP,BBCBreaking,business,WSJ,FT,TechCrunch,CNBC,TheEconomist,verge
# Optional extra X searches, comma separated
X_SEARCH_TERMS=
# Posts to collect per run. Apify's free plan returns at most 10 with this scraper; a paid plan removes that limit.
X_MAX_POSTS=150
# The most one Apify run may cost, in US dollars
APIFY_MAX_USD_PER_RUN=0.50
# How many trending stories to write each day
TRENDING_COUNT=5
# What the daily run writes: trending (stories from X, needs APIFY_TOKEN) or sections (one per section below)
AI_DAILY_MODE=trending

# Daily AI drafts. Hour of day (0-23, server time) to run; leave empty to turn off.
AI_DAILY_HOUR=
# Sections to write one draft for each day
AI_DAILY_SECTIONS=startups,funding,technology
# false = save as drafts for an editor to review (recommended). true = publish straight away, unreviewed.
# When true, a trending story is published only if two independent news outlets confirm it; the rest are skipped.
AI_AUTO_PUBLISH=false
